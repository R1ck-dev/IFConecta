<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.henrique.ifconecta.desktop.controller.LoginController"
      styleClass="auth-shell">

    <!-- ───── Painel ilustrativo ───── -->
    <VBox styleClass="auth-art" prefWidth="460.0" spacing="18.0">
        <HBox alignment="CENTER_LEFT" spacing="11.0">
            <Label text="iC" styleClass="brand-mark"
                   minWidth="40.0" minHeight="40.0" prefWidth="40.0" prefHeight="40.0"
                   maxWidth="40.0" maxHeight="40.0"/>
            <Label text="IFConecta" styleClass="auth-art-brand"/>
        </HBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Label styleClass="auth-art-hero" wrapText="true"
               text="A rede do Campus Salto, feita por quem vive o campus."/>
        <Label styleClass="auth-art-tag" wrapText="true"
               text="Timeline, clubes e comunicados — tudo em um só lugar. Sem ruído de redes sociais, com a cara da nossa comunidade."/>
    </VBox>

    <!-- ───── Formulário ───── -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-form-wrap">
        <padding>
            <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
        </padding>
        <VBox styleClass="auth-form" maxWidth="380.0" alignment="CENTER_LEFT">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="iC" styleClass="brand-mark"
                       minWidth="32.0" minHeight="32.0" prefWidth="32.0" prefHeight="32.0"
                       maxWidth="32.0" maxHeight="32.0"/>
                <Label text="IFConecta" styleClass="brand-text"/>
            </HBox>

            <Label text="Acesse sua conta" styleClass="auth-title"/>
            <Label text="Use seu email institucional do IFSP." styleClass="auth-subtitle"/>

            <!-- Email -->
            <VBox spacing="5.0">
                <Label text="Email" styleClass="field-label"/>
                <HBox fx:id="emailGroup" styleClass="input-group" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fth-mail" iconSize="16"/>
                    <TextField fx:id="emailField" HBox.hgrow="ALWAYS"
                               promptText="seu.nome@aluno.ifsp.edu.br"/>
                </HBox>
                <Label fx:id="emailError" styleClass="field-error" managed="false" visible="false"/>
            </VBox>

            <!-- Senha -->
            <VBox spacing="5.0">
                <Label text="Senha" styleClass="field-label"/>
                <HBox fx:id="senhaGroup" styleClass="input-group" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fth-lock" iconSize="16"/>
                    <PasswordField fx:id="senhaField" HBox.hgrow="ALWAYS" promptText="••••••••"/>
                    <TextField fx:id="senhaVisible" HBox.hgrow="ALWAYS" promptText="••••••••"
                               managed="false" visible="false"/>
                    <Button styleClass="hdr-icon-btn" onAction="#onToggleSenha">
                        <graphic>
                            <FontIcon fx:id="toggleSenhaIcon" iconLiteral="fth-eye" iconSize="16"/>
                        </graphic>
                    </Button>
                </HBox>
                <Label fx:id="senhaError" styleClass="field-error" managed="false" visible="false"/>
            </VBox>

            <Button fx:id="entrarBtn" text="Entrar" styleClass="btn, btn-block" onAction="#onEntrar"/>

            <HBox alignment="CENTER_LEFT" spacing="4.0">
                <Label text="Não tem uma conta?" styleClass="auth-form-foot"/>
                <Hyperlink text="Cadastrar como aluno" styleClass="link" onAction="#onCadastrar"/>
            </HBox>

            <HBox styleClass="auth-info-box" alignment="TOP_LEFT">
                <FontIcon iconLiteral="fth-info" iconSize="14"/>
                <Label wrapText="true"
                       text="Professores e servidores devem aguardar o convite institucional por email para definir senha."/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.TimelineController"
            styleClass="content-area" fitToWidth="true" hbarPolicy="NEVER">

    <StackPane alignment="TOP_CENTER">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox maxWidth="700.0" spacing="14.0">

            <VBox spacing="2.0">
                <Label text="Timeline" styleClass="page-title"/>
                <Label text="O que está acontecendo no campus agora" styleClass="page-sub"/>
            </VBox>

            <!-- Composer -->
            <HBox styleClass="composer" alignment="CENTER_LEFT" onMouseClicked="#onComposer">
                <StackPane fx:id="composerAvatar"/>
                <Label fx:id="composerFaux" styleClass="composer-faux" HBox.hgrow="ALWAYS"/>
                <Button text="Postar" styleClass="btn, btn-sm" onAction="#onComposer">
                    <graphic>
                        <FontIcon iconLiteral="fth-plus" iconSize="14"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Feed -->
            <VBox fx:id="feedBox" spacing="14.0"/>

            <!-- Indicador de carregamento -->
            <StackPane fx:id="loadingBox" alignment="CENTER" managed="false" visible="false">
                <padding>
                    <Insets top="32.0" bottom="32.0"/>
                </padding>
                <ProgressIndicator prefWidth="42.0" prefHeight="42.0"/>
            </StackPane>

            <!-- Paginação -->
            <StackPane alignment="CENTER">
                <Button fx:id="carregarMaisBtn" text="Carregar mais"
                        styleClass="btn, btn-outline" onAction="#onCarregarMais"
                        managed="false" visible="false"/>
            </StackPane>
        </VBox>
    </StackPane>
</ScrollPane>

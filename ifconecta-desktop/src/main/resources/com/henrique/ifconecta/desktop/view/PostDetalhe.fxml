<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.PostDetalheController">
    <VBox spacing="14">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Button text="Voltar" onAction="#onVoltar"/>
        <VBox fx:id="postBox" spacing="6"/>
        <Label text="Comentarios" styleClass="titulo"/>
        <VBox fx:id="comentariosBox" spacing="8"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="comentarioField" HBox.hgrow="ALWAYS" promptText="Escreva um comentario..."/>
            <Button text="Comentar" onAction="#onComentar"/>
        </HBox>
    </VBox>
</ScrollPane>

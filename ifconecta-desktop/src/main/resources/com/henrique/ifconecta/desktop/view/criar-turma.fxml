<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.henrique.ifconecta.desktop.controller.CriarTurmaController"
      styleClass="modal-root" prefWidth="500.0">

    <VBox spacing="2.0">
        <Label text="Solicitar turma" styleClass="modal-title"/>
        <Label text="A solicitação fica pendente até o professor aprovar." styleClass="modal-sub"
               wrapText="true"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Disciplina" styleClass="field-label"/>
        <ComboBox fx:id="disciplinaCombo" styleClass="combo-box" maxWidth="Infinity"
                  promptText="Selecione a disciplina"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Professor" styleClass="field-label"/>
        <ComboBox fx:id="professorCombo" styleClass="combo-box" maxWidth="Infinity"
                  promptText="Selecione o professor"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Semestre" styleClass="field-label"/>
        <TextField fx:id="semestreField" styleClass="input" promptText="2026.1"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Código da turma" styleClass="field-label"/>
        <TextField fx:id="codigoField" styleClass="input" promptText="ex.: A"/>
    </VBox>

    <Label fx:id="erroLabel" styleClass="field-error" managed="false" visible="false" wrapText="true"/>

    <HBox spacing="10.0">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" styleClass="btn, btn-outline" onAction="#onCancelar"/>
        <Button fx:id="confirmarBtn" text="Solicitar turma" styleClass="btn" onAction="#onConfirmar"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.AdminController"
            styleClass="content-area" fitToWidth="true" hbarPolicy="NEVER">

    <StackPane alignment="TOP_CENTER">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox maxWidth="820.0" spacing="14.0">

            <VBox spacing="2.0">
                <Label text="Painel administrativo" styleClass="page-title"/>
                <Label text="Convites de servidores" styleClass="page-sub"/>
            </VBox>

            <!-- Convidar professor -->
            <VBox styleClass="card" spacing="10.0">
                <Label text="Convidar professor" styleClass="section-title"/>

                <VBox spacing="5.0">
                    <Label text="Nome" styleClass="field-label"/>
                    <TextField fx:id="profNomeField" styleClass="input"
                               promptText="Nome completo do professor"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="E-mail acadêmico" styleClass="field-label"/>
                    <TextField fx:id="profEmailField" styleClass="input"
                               promptText="professor@ifsp.edu.br"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="SIAPE" styleClass="field-label"/>
                    <TextField fx:id="profSiapeField" styleClass="input"
                               promptText="Matrícula SIAPE"/>
                </VBox>

                <Label fx:id="profError" styleClass="field-error"
                       managed="false" visible="false" wrapText="true"/>

                <HBox>
                    <Button fx:id="profBtn" text="Enviar convite" styleClass="btn"
                            onAction="#onConvidarProfessor"/>
                </HBox>
            </VBox>

            <!-- Convidar institucional -->
            <VBox styleClass="card" spacing="10.0">
                <Label text="Convidar institucional" styleClass="section-title"/>

                <VBox spacing="5.0">
                    <Label text="Nome" styleClass="field-label"/>
                    <TextField fx:id="instNomeField" styleClass="input"
                               promptText="Nome completo do servidor"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="E-mail acadêmico" styleClass="field-label"/>
                    <TextField fx:id="instEmailField" styleClass="input"
                               promptText="servidor@ifsp.edu.br"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Setor" styleClass="field-label"/>
                    <TextField fx:id="instSetorField" styleClass="input"
                               promptText="ex.: Coordenadoria de Registros"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label text="Cargo" styleClass="field-label"/>
                    <TextField fx:id="instCargoField" styleClass="input"
                               promptText="ex.: Assistente em Administração"/>
                </VBox>

                <Label fx:id="instError" styleClass="field-error"
                       managed="false" visible="false" wrapText="true"/>

                <HBox>
                    <Button fx:id="instBtn" text="Enviar convite" styleClass="btn"
                            onAction="#onConvidarInstitucional"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>

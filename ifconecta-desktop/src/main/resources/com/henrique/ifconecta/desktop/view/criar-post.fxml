<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.henrique.ifconecta.desktop.controller.CriarPostController"
      styleClass="modal-root" fx:id="raiz" prefWidth="480.0">

    <Label text="Novo post" styleClass="modal-title"/>

    <!-- Conteúdo -->
    <VBox spacing="4.0">
        <Label text="Conteúdo" styleClass="field-label"/>
        <TextArea fx:id="conteudoArea" styleClass="text-area" wrapText="true"
                  prefRowCount="4" promptText="No que você está pensando?"/>
        <Label fx:id="conteudoErro" styleClass="field-error" managed="false" visible="false"/>
    </VBox>

    <!-- Clube -->
    <VBox spacing="4.0">
        <Label text="Clube" styleClass="field-label"/>
        <ComboBox fx:id="clubeCombo" styleClass="combo-box" maxWidth="Infinity"
                  promptText="Clube (opcional)"/>
    </VBox>

    <!-- Anônimo -->
    <CheckBox fx:id="anonimoCheck" text="Postar como anônimo"/>

    <!-- Ações -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" styleClass="btn, btn-outline" onAction="#onCancelar"/>
        <Button fx:id="publicarBtn" text="Publicar" styleClass="btn" onAction="#onPublicar"/>
    </HBox>
</VBox>

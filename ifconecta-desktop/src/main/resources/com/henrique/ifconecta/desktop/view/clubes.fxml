<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.ClubesController"
            styleClass="content-area" fitToWidth="true" hbarPolicy="NEVER">

    <StackPane alignment="TOP_CENTER">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox maxWidth="820.0" spacing="14.0">

            <!-- Cabeçalho -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Clubes" styleClass="page-title"/>
                    <Label text="Encontre e participe de clubes do campus" styleClass="page-sub"/>
                </VBox>
                <Button text="Criar clube" styleClass="btn" onAction="#onCriarClube">
                    <graphic>
                        <FontIcon iconLiteral="fth-plus" iconSize="14"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Meus clubes -->
            <VBox spacing="8.0">
                <Label text="Meus clubes" styleClass="section-title"/>
                <VBox fx:id="meusClubesBox" spacing="10.0"/>
            </VBox>

            <!-- Explorar -->
            <VBox spacing="8.0">
                <Label text="Explorar" styleClass="section-title"/>
                <VBox fx:id="explorarBox" spacing="10.0"/>
            </VBox>

            <!-- Indicador de carregamento -->
            <StackPane fx:id="loadingBox" alignment="CENTER" managed="false" visible="false">
                <padding>
                    <Insets top="32.0" bottom="32.0"/>
                </padding>
                <ProgressIndicator prefWidth="42.0" prefHeight="42.0"/>
            </StackPane>

            <!-- Paginação -->
            <StackPane alignment="CENTER">
                <Button fx:id="carregarMaisBtn" text="Carregar mais"
                        styleClass="btn, btn-outline" onAction="#onCarregarMais"
                        managed="false" visible="false"/>
            </StackPane>

            <Region prefHeight="4.0"/>
        </VBox>
    </StackPane>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.AdminController">
    <VBox spacing="14">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Label text="Painel administrativo" styleClass="titulo"/>

        <!-- Card 1: convidar professor -->
        <VBox styleClass="card" spacing="8">
            <Label text="Convidar professor" style="-fx-font-weight: bold;"/>
            <Label text="Nome"/>
            <TextField fx:id="profNome" promptText="Nome do professor"/>
            <Label text="E-mail academico"/>
            <TextField fx:id="profEmail" promptText="professor@ifsp.edu.br"/>
            <Label text="SIAPE"/>
            <TextField fx:id="profSiape" promptText="SIAPE"/>
            <Button text="Enviar convite" onAction="#onConvidarProfessor"/>
        </VBox>

        <!-- Card 2: convidar institucional -->
        <VBox styleClass="card" spacing="8">
            <Label text="Convidar institucional" style="-fx-font-weight: bold;"/>
            <Label text="Nome"/>
            <TextField fx:id="instNome" promptText="Nome do institucional"/>
            <Label text="E-mail academico"/>
            <TextField fx:id="instEmail" promptText="institucional@ifsp.edu.br"/>
            <Label text="Setor"/>
            <TextField fx:id="instSetor" promptText="Setor"/>
            <Label text="Cargo"/>
            <TextField fx:id="instCargo" promptText="Cargo"/>
            <Button text="Enviar convite" onAction="#onConvidarInstitucional"/>
        </VBox>
    </VBox>
</ScrollPane>

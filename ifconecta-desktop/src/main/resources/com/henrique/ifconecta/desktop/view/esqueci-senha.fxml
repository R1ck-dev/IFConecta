<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.henrique.ifconecta.desktop.controller.EsqueciSenhaController"
      styleClass="auth-shell">

    <!-- ───── Painel ilustrativo ───── -->
    <VBox styleClass="auth-art" prefWidth="460.0" spacing="18.0">
        <HBox alignment="CENTER_LEFT" spacing="11.0">
            <Label text="iC" styleClass="brand-mark"
                   minWidth="40.0" minHeight="40.0" prefWidth="40.0" prefHeight="40.0"
                   maxWidth="40.0" maxHeight="40.0"/>
            <Label text="IFConecta" styleClass="auth-art-brand"/>
        </HBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Label styleClass="auth-art-hero" wrapText="true"
               text="Recupere o acesso à sua conta."/>
        <Label styleClass="auth-art-tag" wrapText="true"
               text="Enviaremos um link seguro para o seu e-mail institucional para você redefinir a senha."/>
    </VBox>

    <!-- ───── Formulário ───── -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="auth-form-wrap">
        <padding>
            <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
        </padding>
        <VBox styleClass="auth-form" maxWidth="380.0" alignment="CENTER_LEFT">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="iC" styleClass="brand-mark"
                       minWidth="32.0" minHeight="32.0" prefWidth="32.0" prefHeight="32.0"
                       maxWidth="32.0" maxHeight="32.0"/>
                <Label text="IFConecta" styleClass="brand-text"/>
            </HBox>

            <Label text="Recuperar senha" styleClass="auth-title"/>
            <Label text="Informe seu e-mail e enviaremos um link para redefinir a senha."
                   styleClass="auth-subtitle" wrapText="true"/>

            <!-- E-mail -->
            <VBox spacing="5.0">
                <Label text="E-mail" styleClass="field-label"/>
                <HBox fx:id="emailGroup" styleClass="input-group" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fth-mail" iconSize="16"/>
                    <TextField fx:id="emailField" HBox.hgrow="ALWAYS"
                               promptText="seu.nome@aluno.ifsp.edu.br"/>
                </HBox>
                <Label fx:id="emailError" styleClass="field-error" managed="false" visible="false"/>
            </VBox>

            <Button fx:id="enviarBtn" text="Enviar link" styleClass="btn, btn-block"
                    onAction="#onEnviar"/>

            <HBox alignment="CENTER_LEFT" spacing="4.0">
                <Hyperlink text="Voltar ao login" styleClass="link" onAction="#onVoltarLogin"/>
            </HBox>

            <HBox styleClass="auth-info-box" alignment="TOP_LEFT">
                <FontIcon iconLiteral="fth-info" iconSize="14"/>
                <Label wrapText="true"
                       text="Por segurança, o link de redefinição expira após um curto período. Verifique também a pasta de spam."/>
            </HBox>

        </VBox>
    </StackPane>
</HBox>

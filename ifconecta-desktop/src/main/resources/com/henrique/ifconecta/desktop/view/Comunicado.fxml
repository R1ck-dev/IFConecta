<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.ComunicadoController">
    <VBox spacing="12">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Label text="Enviar comunicado" styleClass="titulo"/>
        <Label text="Titulo"/>
        <TextField fx:id="tituloField" promptText="Titulo do comunicado"/>
        <Label text="Mensagem"/>
        <TextArea fx:id="mensagemArea" wrapText="true" prefRowCount="4" promptText="Escreva a mensagem"/>
        <Label text="Publico"/>
        <ComboBox fx:id="publicoCombo"/>
        <Label text="Clube (se o publico for Clube)"/>
        <ComboBox fx:id="clubeCombo"/>
        <HBox spacing="8">
            <Button text="Enviar" onAction="#onEnviar"/>
            <Button text="Cancelar" onAction="#onCancelar"/>
        </HBox>
    </VBox>
</ScrollPane>

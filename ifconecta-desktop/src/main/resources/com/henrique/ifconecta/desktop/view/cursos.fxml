<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.CursosController"
            styleClass="content-area" fitToWidth="true" hbarPolicy="NEVER">

    <StackPane alignment="TOP_CENTER">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox maxWidth="860.0" spacing="14.0">

            <VBox spacing="2.0">
                <Label text="Cursos" styleClass="page-title"/>
                <Label text="Cursos do campus e suas disciplinas" styleClass="page-sub"/>
            </VBox>

            <!-- Lista de cursos -->
            <VBox fx:id="listaBox" spacing="12.0"/>

            <!-- Indicador de carregamento -->
            <StackPane fx:id="loadingBox" alignment="CENTER" managed="false" visible="false">
                <padding>
                    <Insets top="32.0" bottom="32.0"/>
                </padding>
                <ProgressIndicator prefWidth="42.0" prefHeight="42.0"/>
            </StackPane>
        </VBox>
    </StackPane>
</ScrollPane>

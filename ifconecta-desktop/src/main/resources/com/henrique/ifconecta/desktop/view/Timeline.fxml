<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.TimelineController">

    <VBox spacing="14">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Timeline" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Criar post" onAction="#onCriarPost"/>
        </HBox>

        <!-- Os cards de post sao criados pelo controller e colocados aqui. -->
        <VBox fx:id="lista" spacing="12"/>
    </VBox>

</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.henrique.ifconecta.desktop.controller.CadastroController">

    <VBox styleClass="card" spacing="12" maxWidth="360" maxHeight="-Infinity" alignment="CENTER_LEFT">
        <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

        <Label text="Criar conta de aluno" styleClass="titulo"/>

        <Label text="Nome completo"/>
        <TextField fx:id="nomeField" promptText="Seu nome completo"/>

        <Label text="Email"/>
        <TextField fx:id="emailField" promptText="seu.nome@aluno.ifsp.edu.br"/>

        <Label text="Senha (mínimo 8)"/>
        <PasswordField fx:id="senhaField" promptText="Sua senha"/>

        <Label text="Prontuário"/>
        <TextField fx:id="prontuarioField" promptText="Ex.: SL000000X"/>

        <Button fx:id="cadastrarBtn" text="Cadastrar" maxWidth="Infinity" onAction="#onCadastrar"/>

        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="Já tem conta?"/>
            <Hyperlink text="Entrar" onAction="#onVoltar"/>
        </HBox>
    </VBox>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.CriarClubeController">
    <VBox spacing="12">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Label text="Criar clube" styleClass="titulo"/>
        <Label text="Nome"/>
        <TextField fx:id="nomeField" promptText="Nome do clube"/>
        <Label text="Descricao"/>
        <TextArea fx:id="descricaoArea" wrapText="true" prefRowCount="3" promptText="Sobre o que e o clube"/>
        <Label text="Tipo de acesso"/>
        <ComboBox fx:id="tipoCombo"/>
        <HBox spacing="8">
            <Button text="Criar clube" onAction="#onCriar"/>
            <Button text="Cancelar" onAction="#onCancelar"/>
        </HBox>
    </VBox>
</ScrollPane>

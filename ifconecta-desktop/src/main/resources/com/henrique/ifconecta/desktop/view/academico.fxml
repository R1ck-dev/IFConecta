<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.henrique.ifconecta.desktop.controller.AcademicoController"
            styleClass="content-area" fitToWidth="true" hbarPolicy="NEVER">

    <StackPane alignment="TOP_CENTER">
        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox maxWidth="860.0" spacing="14.0">

            <!-- Cabeçalho -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Acadêmico" styleClass="page-title"/>
                    <Label text="Turmas, matrículas e solicitações do campus" styleClass="page-sub"/>
                </VBox>
                <Button text="Solicitar turma" styleClass="btn" onAction="#onSolicitarTurma">
                    <graphic>
                        <FontIcon iconLiteral="fth-plus" iconSize="14"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Abas -->
            <HBox styleClass="tabs">
                <Button fx:id="tabMinhas" text="Minhas turmas" styleClass="tab"
                        onAction="#onTabMinhas"/>
                <Button fx:id="tabTodas" text="Todas" styleClass="tab"
                        onAction="#onTabTodas"/>
                <Button fx:id="tabLeciono" text="Leciono" styleClass="tab"
                        onAction="#onTabLeciono"/>
                <Button fx:id="tabSolicitacoes" text="Solicitações" styleClass="tab"
                        onAction="#onTabSolicitacoes"/>
            </HBox>

            <!-- Lista de turmas -->
            <VBox fx:id="listaBox" spacing="10.0"/>

            <!-- Indicador de carregamento -->
            <StackPane fx:id="loadingBox" alignment="CENTER" managed="false" visible="false">
                <padding>
                    <Insets top="32.0" bottom="32.0"/>
                </padding>
                <ProgressIndicator prefWidth="42.0" prefHeight="42.0"/>
            </StackPane>

            <!-- Paginação (aba Todas) -->
            <StackPane alignment="CENTER">
                <Button fx:id="carregarMaisBtn" text="Carregar mais"
                        styleClass="btn, btn-outline" onAction="#onCarregarMais"
                        managed="false" visible="false"/>
            </StackPane>

            <Region prefHeight="1.0"/>
        </VBox>
    </StackPane>
</ScrollPane>
